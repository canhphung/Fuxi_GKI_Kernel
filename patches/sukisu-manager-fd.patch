diff --git a/kernel/supercall/supercall.c b/kernel/supercall/supercall.c
--- a/kernel/supercall/supercall.c
+++ b/kernel/supercall/supercall.c
@@ -21,7 +21,10 @@ int ksu_install_fd(void)
     struct file *filp;
     int fd;
 
-    fd = get_unused_fd_flags(O_CLOEXEC);
+    /* The manager receives this descriptor across an exec boundary. Keeping
+     * FD_CLOEXEC here makes builtin SukiSU appear unavailable on some ROMs.
+     */
+    fd = get_unused_fd_flags(0);
     if (fd < 0) {
         pr_err("ksu_install_fd: failed to get unused fd\n");
         return fd;
